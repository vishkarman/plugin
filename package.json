{
  "name": "@vishkarman/plugin",
  "version": "0.9.4-stage.3",
  "description": "Vishvakarma design workspace, project tools and source adapters for DSH",
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "./dist/host.js",
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "vishvakarma-connect": "./dist/connect.js"
  },
  "files": [
    "dist",
    "skills",
    "contracts",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "update:dsh": "node scripts/update-dsh.mjs",
    "connect": "node dist/connect.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.3 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3 || 0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.5",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-commands": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar-browser": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@deepseek-ai/dsh-plugin-manager": "0.2.1-rc.5",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "@sinclair/typebox": "^0.34.41",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/semver": "7.7.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "^0.25.0",
    "lucide-react": "1.66.0",
    "postcss": "8.5.32",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "semver": "7.8.5",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "yaml": "^2.8.0",
    "zod": "^4.6.7"
  }
}
